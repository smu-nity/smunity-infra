global:
  resolve_timeout: 5m

route:
  receiver: "slack-notifications"

receivers:
  - name: "slack-notifications"
    slack_configs:
      - api_url: "${SLACK_WEBHOOK}"
        channel: "#smunity"
        send_resolved: true
        text: |-
          {{ range .Alerts }}
          • *요약*: {{ .Annotations.summary }}
          • *설명*: {{ .Annotations.description }}
          {{ end }}
